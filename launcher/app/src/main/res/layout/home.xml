<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.carhome.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <TextView
        android:id="@+id/attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:text="@string/map_attribution"
        android:textColor="#808696A8"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/search_pill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/where_to"
            android:textColor="@color/text"
            android:textSize="17sp" />
    </LinearLayout>

    <include layout="@layout/nav_banner" />

    <include layout="@layout/nav_preview" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:id="@+id/ambient"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/text"
                    android:textSize="88sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:format12Hour="EEEE, d MMMM yyyy"
                    android:format24Hour="EEEE, d MMMM yyyy"
                    android:textColor="@color/text_soft"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <ImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/text_soft"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#8E94A6"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/prayers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/now_playing"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/art"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/art_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/not_playing"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tap_to_open"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/prev"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/flat_button"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/round_button"
                android:contentDescription="@string/play_pause"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/flat_button"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/dock_bg"
        android:orientation="horizontal"
        android:padding="6dp" />

    <include layout="@layout/nav_search" />

    <FrameLayout
        android:id="@+id/all_apps_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9080A12"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <GridView
            android:id="@+id/all_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadingEdgeLength="40dp"
            android:horizontalSpacing="6dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="7"
            android:paddingStart="28dp"
            android:paddingTop="64dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp" />

        <ImageButton
            android:id="@+id/all_apps_close"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_margin="8dp"
            android:background="@drawable/flat_button"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_chevron_down" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/all_apps"
            android:textColor="#C8CCD6"
            android:textSize="16sp" />
    </FrameLayout>
</merge>
